{
  "name": "memeaim-dpsk-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MEMEAIM 3D-DeepSeek offline desktop edition",
  "author": "MemeAim contributors",
  "main": "main.cjs",
  "scripts": {
    "build:web": "node ../dpsk/build.mjs",
    "start": "npm run build:web && electron .",
    "test": "node --test --test-isolation=none asset-server.test.cjs",
    "pack": "npm run build:web && electron-builder --win --x64 --dir",
    "dist": "npm run build:web && electron-builder --win --x64 --publish never",
    "smoke": "node run-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.passerbyask.memeaim.dpsk",
    "productName": "MemeAim 3D-DeepSeek V41",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "asset-server.cjs",
      "smoke-dpsk.cjs",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../dpsk/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "MemeAim-3D-DeepSeek-V41-${version}-Windows-x64-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "MemeAim-3D-DeepSeek-V41-${version}-Windows-${arch}-Portable.${ext}"
  }
}
